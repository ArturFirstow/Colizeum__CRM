// ─────────────────────────────────────────────────────────────────────────────
// Colizeum Workspace — схема данных (блупринт, раздел 5).
//
// Заводим ВСЕ сущности сразу, даже те, что наполним в поздних фазах (v1/v2),
// чтобы не переписывать модель позже.
//
// dev: SQLite. prod: PostgreSQL (см. раздел 13). SQLite не поддерживает native
// enum и scalar-list, поэтому перечисления храним как String с зафиксированным
// набором значений (валидация — Zod на границе API, значения — в src/lib/enums.ts).
// При переезде на Postgres поля-строки можно заменить на enum без потери данных.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Пользователи сервиса ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Manager") // Owner | Manager | Director (см. enums.ts)
  // Направление работы: Ads — реклама/коллаборации, Tournaments — турниры (Артём).
  // От track зависит набор разделов в кабинете (см. src/lib/nav.ts).
  track        String   @default("Ads") // Ads | Tournaments
  // Куда слать уведомления (вопрос руководителю, поручение, блокер).
  // Пусто — сотрудник уведомления не получает. Настройка — docs/TELEGRAM.md.
  telegramChatId String?
  // До какого момента сотрудник видел мессенджер: по нему считается маячок
  // непрочитанного. Одно поле на человека — проще, чем отметки по каналам.
  chatSeenAt   DateTime?
  // Фото сотрудника. Храним ссылку на файл в общем хранилище (/api/files/<id>),
  // чтобы не заводить отдельный механизм картинок.
  avatarUrl    String?
  createdAt    DateTime @default(now())

  ownedDeals       Deal[]            @relation("DealOwner")
  assignedDeals    Deal[]            @relation("DealAssignee")
  assignedTasks    Task[]            @relation("TaskAssignee")
  uploadedVersions DocumentVersion[] @relation("VersionUploader")
  ownedAdvertisers Advertiser[]      @relation("AdvertiserOwner")
  ownedTasks       Task[]            @relation("TaskOwner")
  assignedByMe     Task[]            @relation("TaskAssignedBy")
  chatMessages     ChatMessage[]     @relation("ChatAuthor")
  channelMemberships ChannelMember[]
  assignedLeads    Lead[]            @relation("LeadAssignee")
  decisionRequests DecisionRequest[] @relation("DecisionRequester")
  handoversGiven   Handover[]        @relation("HandoverFrom")
  handoversTaken   Handover[]        @relation("HandoverTo")
}

// ── Рекламодатель / агентство (карточка CRM) ─────────────────────────────────
model Advertiser {
  id          String   @id @default(cuid())
  nameRu      String
  nameEn      String?
  legalEntity String? // юрлицо целиком, напр. АО «ТБанк»
  inn         String?
  kpp         String?
  ogrn        String?
  type        String   @default("Рекламодатель") // Рекламодатель | Агентство (см. enums.ts)
  status      String   @default("Активный")
  archived    Boolean  @default(false) // в Архиве (v2, п.1.2)
  // Личный кабинет: клиент принадлежит сотруднику; null = данные до разделения.
  ownerId     String?
  goals       String?
  notes       String?
  // Реквизиты для карточки контрагента.
  address       String?
  bankAccount   String?
  bankName      String?
  bik           String?
  signatory     String? // подписант
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner           User?            @relation("AdvertiserOwner", fields: [ownerId], references: [id])
  contacts        Contact[]
  deals           Deal[]
  documents       Document[]
  tasks           Task[]
  creatives       Creative[]
  agencyClients   AgencyClient[] // если контрагент = Агентство
  plannedPayments PlannedPayment[]
  placements      Placement[]
  dailyStatuses   DailyStatus[]
  promoBatches    PromoBatch[]
  decisionRequests DecisionRequest[]

  @@index([ownerId])
}

// ── Креатив (макет) — блок «Креативы» в карточке клиента (v2, п.1.3) ─────────
model Creative {
  id           String   @id @default(cuid())
  advertiserId String
  dealId       String?
  title        String
  size         String? // напр. 1080×1080, 1920×1080
  status       String   @default("В работе") // В работе | На согласовании | Согласован | Отклонён
  notes        String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
}

// ── Клиент агентства (если контрагент = Агентство) ──────────────────────────
model AgencyClient {
  id           String   @id @default(cuid())
  advertiserId String // агентство-владелец
  name         String
  brand        String?
  inn          String?
  notes        String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
}

// ── Контакт у рекламодателя ──────────────────────────────────────────────────
model Contact {
  id           String  @id @default(cuid())
  advertiserId String
  fio          String
  role         String?
  email        String?
  phone        String?
  telegram     String?
  isPrimary    Boolean @default(false)

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
}

// ── Сделка / проект ──────────────────────────────────────────────────────────
model Deal {
  id                   String    @id @default(cuid())
  advertiserId         String
  title                String
  dealType             String? // прямой | агентство | технический (v2, п.1.3)
  finalBrand           String? // конечный бренд (при агентстве/цепочке)
  contractConstruction String? // A..E (справочник конструкций договоров, v2 п.3.5)
  stage                String    @default("Лид") // 9 стадий (v2, п.1.1)
  urgency              String? // Максимальная | Высокая | Средняя | Низкая | По запросу | Разово
  ownerId              String?
  assigneeId           String?
  amount               Float? // сумма из МП (текущая)
  contractTotal        Float? // сумма по договору за весь период сотрудничества
  vatIncluded          Boolean   @default(true)
  currency             String    @default("RUB")
  periodText           String? // срок как ТЕКСТ, не жёсткие даты (правило блупринта)
  launchDate           DateTime? // дата запуска
  paymentTerms         String?
  contractNumber       String?
  contractDate         DateTime?
  legalResponsible     String? // юрист
  // Блокер = флажок + комментарий. Сделка считается заблокированной ТОЛЬКО при
  // поднятом флажке: текст может остаться как история, но висеть в сводках не будет.
  blocker              String?
  blockerActive        Boolean   @default(false)
  situational          String? // «Ситуативные блокеры и срочные задачи» (v2, п.1.3) — НЕ в базу знаний
  nextStep             String?
  nextStepDate         DateTime?
  decisionPending      String? // непустое → попадает в блок «Решения ждут вас»
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  advertiser  Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  owner       User?        @relation("DealOwner", fields: [ownerId], references: [id])
  assignee    User?        @relation("DealAssignee", fields: [assigneeId], references: [id])
  documents       Document[]
  tasks           Task[]
  creatives       Creative[]
  mediaPlans      MediaPlan[]
  invoices        Invoice[]
  closingDocs     ClosingDoc[]
  ordMarkings     OrdMarking[]
  promoBatches    PromoBatch[]
  plannedPayments PlannedPayment[]
  placements      Placement[]
  dailyStatuses   DailyStatus[]
  decisionRequests DecisionRequest[]

  @@index([advertiserId])
  @@index([stage])
}

// ── Логический документ (напр. «Договор Т-Банк») ─────────────────────────────
model Document {
  id               String   @id @default(cuid())
  dealId           String?
  advertiserId     String
  type             String // см. DocumentType в enums.ts
  title            String
  currentVersionId String? // id актуальной DocumentVersion
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  advertiser Advertiser        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@index([advertiserId])
  @@index([dealId])
}

// ── Конкретная версия-файл документа (иммутабельна) ──────────────────────────
model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  versionNo    Int
  storageKey   String // ключ объекта в StorageProvider
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  changeNote   String?
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("VersionUploader", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@index([sha256])
}

// ── Задача (юрист / дизайн / менеджер / бухгалтерия / ОРД) ───────────────────
model Task {
  id           String    @id @default(cuid())
  dealId       String?
  advertiserId String?
  title        String
  kind         String    @default("Менеджер") // Юрист | Дизайн | Менеджер | Бухгалтерия | ОРД | Прочее
  assigneeId   String?
  status       String    @default("Открыта") // Открыта | В работе | Ждёт | Готова
  // На чьей стороне сейчас согласование: «Мы» | «Клиент» (доска задач).
  side         String    @default("Мы")
  // Чья задача (личный кабинет сотрудника); null = данные до разделения.
  ownerId      String?
  // Кто поручил задачу (руководитель). null = обычная личная задача сотрудника.
  assignedById String?
  dueDate      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  owner      User?       @relation("TaskOwner", fields: [ownerId], references: [id])
  assignedBy User?       @relation("TaskAssignedBy", fields: [assignedById], references: [id])

  @@index([dealId])
  @@index([status])
  @@index([assignedById])
}

// ── Медиаплан сделки ─────────────────────────────────────────────────────────
model MediaPlan {
  id          String   @id @default(cuid())
  dealId      String
  version     Int      @default(1)
  totalAmount Float?
  vatRate     Int? // 20 | 22 (по дате документа)
  reachTotal  Int?
  cpv         Float?
  cpu         Float?
  notes       String?
  createdAt   DateTime @default(now())

  deal  Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lines MediaPlanLine[]

  @@index([dealId])
}

model MediaPlanLine {
  id          String  @id @default(cuid())
  mediaPlanId String
  formatCode  String?
  formatName  String
  qty         Int?
  period      String?
  unitPrice   Float?
  sum         Float?
  reach       Int?
  geo         String?

  mediaPlan MediaPlan @relation(fields: [mediaPlanId], references: [id], onDelete: Cascade)

  @@index([mediaPlanId])
}

// ── Счёт на оплату ───────────────────────────────────────────────────────────
model Invoice {
  id             String    @id @default(cuid())
  dealId         String
  number         String
  basis          String? // Приложение №… к Договору
  service        String?
  amount         Float?
  vatRate        Int?
  ourBankAccount String? // ⚠️ основной …48430 vs Самокат-fest …55743
  issuedAt       DateTime?
  appendixNo     String?
  createdAt      DateTime  @default(now())

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([dealId])
}

// ── Факт оплаты (платёжное поручение) ───────────────────────────────────────
model Payment {
  id        String    @id @default(cuid())
  invoiceId String
  number    String?
  payer     String?
  payee     String?
  purpose   String?
  amount    Float?
  paidAt    DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ── Закрывающий документ (УПД / Отчёт / Акт сверки) ─────────────────────────
model ClosingDoc {
  id          String    @id @default(cuid())
  dealId      String
  kind        String // УПД | Отчёт | АктСверки
  number      String?
  appendixNo  String?
  upDStatus   Int? // 1 | 2
  periodStart DateTime?
  periodEnd   DateTime?
  amount      Float?
  storageKey  String?
  createdAt   DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ── Маркировка ЕРИД / ОРД ────────────────────────────────────────────────────
model OrdMarking {
  id             String    @id @default(cuid())
  dealId         String
  erid           String?
  role           String // Агентство | Клиент (и др., см. enums.ts)
  finalClient    String? // конечный заказчик при агентстве
  platform       String? // соцсети | моб.приложение | пуши
  status         String    @default("Активна")
  markedAt       DateTime?
  placementStart DateTime? // дата размещения маркировки
  placementEnd   DateTime?
  expiresAt      DateTime? // посты живут до 1 мес
  monthlyClosing Boolean   @default(true) // акты закрываются каждый месяц
  urgent         Boolean   @default(false) // срочно снять креатив / сдать акт
  // Файлы: креатив (картинка) и закрывающий акт (PDF) — метаданные в БД, файл в StorageProvider.
  creativeStorageKey String?
  creativeFileName   String?
  actStorageKey      String?
  actFileName        String?
  createdAt      DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ── Партия промокодов ────────────────────────────────────────────────────────
model PromoBatch {
  id             String    @id @default(cuid())
  advertiserId   String? // карточки промокодов по рекламодателю
  dealId         String?
  mechanic       String // Performance | Acquisition
  nominal        Float?
  qty            Int?
  vatOnUsed      Boolean   @default(true) // +22% на использованные
  delayHours     Int       @default(12) // отсрочка выдачи ≥ 12 ч
  monetization   String    @default("Деньги") // Деньги | Бартер
  validFrom      DateTime? // срок действия
  validTo        DateTime?
  commercialTerms String? // коммерческие условия
  settlement     String? // взаиморасчёт по промокодам
  notes          String?
  createdAt      DateTime  @default(now())

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
  @@index([dealId])
}

// ── Статья базы знаний ───────────────────────────────────────────────────────
model KnowledgeArticle {
  id           String   @id @default(cuid())
  category     String // см. KnowledgeCategory в enums.ts
  title        String
  bodyMarkdown String
  notes        String?
  // Порядок чтения «сверху вниз» по циклу сделки (новые статьи — в конец).
  orderIndex   Int      @default(999)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

// ── Директория ролей (кто за что отвечает) ──────────────────────────────────
model Person {
  id        String   @id @default(cuid())
  role      String
  name      String
  telegram  String?
  email     String?
  scope     String? // напр. «чек B2C», «маркировка», «клубы 50+»
  createdAt DateTime @default(now())
}

// ── Запись дневного журнала (EOD / транскрипт) ──────────────────────────────
// ── Бюджет отдела (кабинет руководителя): доходы + реестр расходов ──────────
// Данные уровня отдела (не по сотрудникам), ведёт руководитель/админ.

model DeptMonthBudget {
  id            String   @id @default(cuid())
  month         String   @unique // «YYYY-MM»
  plannedBudget Float    @default(0) // планируемый бюджет расходов на месяц
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeptIncome {
  id        String   @id @default(cuid())
  month     String // «YYYY-MM»
  source    String // Реклама | Корпоративные турниры | …
  clientName String? // от какого клиента ждём деньги
  w1        Float    @default(0)
  w2        Float    @default(0)
  w3        Float    @default(0)
  w4        Float    @default(0)
  createdAt DateTime @default(now())

  @@index([month])
}

model DeptExpense {
  id             String    @id @default(cuid())
  month          String // «YYYY-MM» (месяц реестра)
  department     String? // Отдел / общесетевые
  category       String? // Статья
  accountingSub  String? // Подстатья для бухгалтерии
  legalEntity    String? // Юр.лицо
  title          String // Подстатья / наименование
  periodicity    String? // Разовый | Повторяющийся
  vatRate        Int       @default(0) // 0 = без НДС, 22 = 22 %
  amountTotal    Float     @default(0) // Сумма ИТОГО (с НДС)
  spentTotal     Float? // Потрачено ИТОГО (факт)
  payFormat      String? // Безнал | Нал | Карта
  payDate        DateTime? // Дата оплаты по договору
  deliveryDate   DateTime? // Дата оказания услуги/поставки
  serviceEndDate DateTime? // Срок окончания услуги
  actClosedDate  DateTime? // Дата закрытия актом услуги
  justification  String? // Обоснование
  description    String?
  status         String    @default("Не согласовано") // Не согласовано | Согласовано | Оплачено
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([month])
}

model JournalEntry {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  // Чей журнал (личный кабинет); null = данные до разделения.
  ownerId          String?
  source           String // EOD | Транскрипт | Чат
  // Встреча: с кем говорили и по какому клиенту — чтобы транскрипт не потерялся.
  meetingWith      String?
  advertiserId     String?
  // ── Показатели встречи для таблицы учёта ──────────────────────────────────
  meetingDate      DateTime? // дата встречи
  startTime        String?   // «HH:MM» начала
  endTime          String?   // «HH:MM» окончания
  durationHours    Float?    // продолжительность в часах, шаг 0,5
  participants     String?   // участники встречи, через запятую
  protocolUrl      String?   // ссылка на протокол/расшифровку
  meetingUrl       String?   // ссылка на саму встречу (запись, Zoom/Meet)
  // Выгрузка строки в Google-таблицу отчётности.
  exportedAt       DateTime?
  exportError      String?
  rawText          String
  parsedSummary    String?
  routedTo         String? // Трекер | База | Архив
  linkedDealIds    String? // JSON-массив id (SQLite не поддерживает scalar-list)
  linkedArticleIds String? // JSON-массив id
  createdAt        DateTime @default(now())
}

// ── Плановый платёж по месяцам (финансовый календарь) ───────────────────────
model PlannedPayment {
  id           String   @id @default(cuid())
  advertiserId String
  dealId       String?
  periodMonth  String // «YYYY-MM» — месяц платежа
  amount       Float
  status       String   @default("План") // План | Оплачено | Просрочено
  paidAt       DateTime?
  note         String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([periodMonth])
}

// ── Бронь размещения (календарь размещений, Gantt) ──────────────────────────
// Строка = слот/формат (slot), ячейка = бренд на период (по неделям).
model Placement {
  id           String    @id @default(cuid())
  advertiserId String? // если бренд заведён как контрагент
  brandLabel   String? // свободное имя бренда (для разовых, без карточки)
  dealId       String?
  slot         String // формат/слот размещения (строка календаря)
  responsible  String? // ответственный менеджер
  startDate    DateTime
  endDate      DateTime
  status       String    @default("Ожидание") // Ожидание | На подписании | Подписан | Завершено
  notes        String?
  createdAt    DateTime  @default(now())

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([startDate])
}

// ── Ежедневный статус по проекту/рекламодателю (для «Сегодня» → отчёт) ──────
model DailyStatus {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  advertiserId String
  dealId       String?
  text         String
  authorId     String? // id пользователя (без жёсткой связи)
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([date])
}

// ── Аудит-лог (v2) ───────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  before     String? // JSON
  after      String? // JSON
  createdAt  DateTime @default(now())
}

// ── Фоновая задача AI-парсинга (v2) ─────────────────────────────────────────
model Job {
  id        String   @id @default(cuid())
  type      String
  payload   String? // JSON
  status    String   @default("pending") // pending | running | done | error
  result    String? // JSON
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// ТУРНИРНЫЙ КОНТУР (кабинет Артёма Чепелюка, track = "Tournaments").
// Отдельный домен: корпоративные коммерческие турниры для брендов-заказчиков.
// Не пересекается с рекламным контуром (Advertiser/Deal/Placement).
// ─────────────────────────────────────────────────────────────────────────────

// ── Контрагент-заказчик турнира (своя база Артёма) ──────────────────────────
model TournamentContractor {
  id            String   @id @default(cuid())
  name          String // компания/бренд-заказчик
  brand         String? // конкретный бренд, если отличается
  contactPerson String? // контактное лицо
  contact       String? // телефон / почта / телеграм
  status        String   @default("Лид") // воронка (см. TOURNAMENT_CONTRACTOR_STATUSES)
  notes         String?
  ownerId       String? // сотрудник-владелец (Артём); null — данные до разделения
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tournaments Tournament[]
  bookings    ArenaBooking[]

  @@index([ownerId])
  @@index([status])
}

// ── Турнир (событие для заказчика) + смета ──────────────────────────────────
model Tournament {
  id           String    @id @default(cuid())
  title        String // название турнира/кубка
  contractorId String? // заказчик из базы
  clientLabel  String? // заказчик текстом (для разовых, без карточки)
  discipline   String? // CS2 | Dota 2 | Valorant | …
  format       String? // Онлайн | Офлайн | Гибрид
  arena        String?   @default("Colizeum Шелепиха") // площадка офлайн-части
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("Планируется") // см. TOURNAMENT_STATUSES
  budgetNote   String? // комментарий к смете
  ownerId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contractor  TournamentContractor?   @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  budgetLines TournamentBudgetLine[]
  bookings    ArenaBooking[]

  @@index([contractorId])
  @@index([ownerId])
  @@index([startDate])
}

// ── Строка сметы турнира (планировка бюджета) ───────────────────────────────
model TournamentBudgetLine {
  id            String   @id @default(cuid())
  tournamentId  String
  category      String // Призовой фонд | Аренда и застройка арены | … (шаблон + свои)
  title         String? // уточнение (напр. «серверы FACEIT»)
  amountPlanned Float    @default(0) // предполагаемая сумма
  amountActual  Float? // фактическая сумма (для сверки)
  notes         String?
  sort          Int      @default(0)
  createdAt     DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
}

// ── Бронь арены Colizeum Шелепиха (календарь дат под заказчика) ──────────────
model ArenaBooking {
  id           String   @id @default(cuid())
  tournamentId String? // связанный турнир
  contractorId String? // заказчик
  clientLabel  String? // заказчик/бренд текстом
  zone         String   @default("Вся арена") // зона/зал арены
  timeSlot     String? // Весь день | Утро | День | Вечер (опц.)
  startDate    DateTime
  endDate      DateTime
  status       String   @default("Ожидание") // см. ARENA_BOOKING_STATUSES
  notes        String?
  createdAt    DateTime @default(now())

  tournament Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  contractor TournamentContractor?  @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([startDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// ВНУТРЕННИЙ МЕССЕНДЖЕР (командный чат: каналы, сообщения, вложения, закрепы).
// Цель — чтобы важное (сообщения/документы) не терялось во внешних чатах.
// ─────────────────────────────────────────────────────────────────────────────

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  isGeneral   Boolean  @default(false) // «Общий» — нельзя удалить
  isDm        Boolean  @default(false) // личный диалог 1-на-1 (виден только участникам)
  createdById String?
  createdAt   DateTime @default(now())

  messages ChatMessage[]
  members  ChannelMember[]
}

// Участник канала — используется для лички (isDm). Обычные каналы видны всем
// без записей membership.
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  createdAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  body      String
  pinned    Boolean  @default(false) // закреплённое сообщение (наверху канала)
  // Привязка к сущности сервиса (денормализовано, без жёсткой связи):
  contextType  String? // advertiser | deal
  contextId    String?
  contextLabel String? // имя клиента/сделки для отображения
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  channel     Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User             @relation("ChatAuthor", fields: [authorId], references: [id])
  attachments ChatAttachment[]

  @@index([channelId])
  @@index([pinned])
}

model ChatAttachment {
  id          String   @id @default(cuid())
  messageId   String
  storageKey  String
  fileName    String
  sizeBytes   Int      @default(0)
  contentType String?
  createdAt   DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

// ── Заявки с сайта colizeum-agency.ru ────────────────────────────────────────
// Тянутся из рабочей Google-таблицы формы (CSV-экспорт, см.
// src/lib/services/leads-sync.ts). Из таблицы приходят только «сырые» поля;
// статус, ответственный и комментарий живут в CRM и синхронизацией не
// перетираются. Ключ дедупликации — requestid формы (externalId).
model Lead {
  id         String    @id @default(cuid())
  externalId String    @unique
  name       String?
  company    String?
  contact    String?
  message    String?
  referer    String?
  formId     String?
  sentAt     DateTime? // когда заявка отправлена с сайта

  status       String  @default("Новая") // Новая | В работе | Квалифицирована | Отказ
  comment      String? // внутренняя пометка менеджера
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([sentAt])
}

// ── Запрос на решение руководителю ───────────────────────────────────────────
// Сотрудник отправляет вопрос, который не может решить сам (согласовать макет,
// выдать доступ, утвердить скидку). У руководителя запрос появляется в блоке
// «Решения, которые ждут вас» на «Сегодня» — с указанием, от кого он пришёл.
model DecisionRequest {
  id          String  @id @default(cuid())
  title       String // что нужно решить
  details     String? // подробности от сотрудника
  kind        String  @default("Согласование") // Согласование | Доступ | Деньги | Другое
  status      String  @default("Открыт") // Открыт | Решён | Отклонён
  answer      String? // решение руководителя
  // Ключ группы вложений (FileAsset.ownerType="decision", ownerId=этот ключ).
  // Заводится в браузере до отправки, поэтому файлы можно приложить сразу в форме.
  attachmentsKey String?

  requesterId String
  requester   User    @relation("DecisionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  advertiserId String?
  advertiser   Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  dealId       String?
  deal         Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@index([requesterId])
}

// ── Файл базы знаний (шаблон договора, прайс, презентация) ───────────────────
// Живёт в StorageProvider, в БД — только метаданные. Нужен, чтобы новичок
// скачал рабочий документ из того же места, где читает регламент.
model KnowledgeFile {
  id          String   @id @default(cuid())
  title       String // как показываем в списке
  category    String   @default("Материалы для клиента")
  description String?
  fileName    String
  sizeBytes   Int
  contentType String?
  storageKey  String
  uploadedAt  DateTime @default(now())

  @@index([category])
}

// ── Универсальное вложение ───────────────────────────────────────────────────
// Одно хранилище файлов на весь сервис: счёт, медиаплан, креатив, макет,
// презентация в базе знаний. Прикрепили в карточке сделки — файл сразу виден
// и в «Документах» клиента (связи advertiserId/dealId заполняются при загрузке).
model FileAsset {
  id          String  @id @default(cuid())
  ownerType   String // knowledge | deal | advertiser | journal
  ownerId     String
  kind        String  @default("Прочее") // Счёт | Медиаплан | Креатив | Документ | Акт | Прочее
  title       String
  fileName    String
  sizeBytes   Int
  contentType String?
  storageKey  String

  // Денормализация для сквозной видимости по клиенту и сделке.
  advertiserId String?
  dealId       String?
  uploadedById String?
  uploadedByName String?

  uploadedAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([advertiserId])
  @@index([dealId])
}


// ── Передача дел на время отпуска ────────────────────────────────────────────
// Клиенты временно переходят к замещающему вместе с саммари по каждому: где
// сейчас, что подписано, что оплачено, что горит. По возвращении — один клик,
// и всё встаёт обратно к прежнему владельцу.
model Handover {
  id         String    @id @default(cuid())
  fromUserId String
  from       User      @relation("HandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  to         User      @relation("HandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)

  reason     String?   // отпуск, больничный, командировка
  startsAt   DateTime  @default(now())
  endsAt     DateTime? // когда планируем вернуть
  note       String?   // что важно знать замещающему
  summary    String?   // общее саммари по всем клиентам (текст)
  status     String    @default("Активна") // Активна | Завершена

  createdAt  DateTime  @default(now())
  returnedAt DateTime?

  items HandoverItem[]

  @@index([toUserId])
  @@index([status])
}

model HandoverItem {
  id           String  @id @default(cuid())
  handoverId   String
  handover     Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  advertiserId String
  // Кому клиент принадлежал ДО передачи — по этому полю возвращаем обратно.
  previousOwnerId String?
  summary      String? // саммари по конкретному клиенту

  @@index([handoverId])
}
