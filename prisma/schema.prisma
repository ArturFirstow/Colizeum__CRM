// ─────────────────────────────────────────────────────────────────────────────
// Colizeum Workspace — схема данных (блупринт, раздел 5).
//
// Заводим ВСЕ сущности сразу, даже те, что наполним в поздних фазах (v1/v2),
// чтобы не переписывать модель позже.
//
// dev: SQLite. prod: PostgreSQL (см. раздел 13). SQLite не поддерживает native
// enum и scalar-list, поэтому перечисления храним как String с зафиксированным
// набором значений (валидация — Zod на границе API, значения — в src/lib/enums.ts).
// При переезде на Postgres поля-строки можно заменить на enum без потери данных.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Пользователи сервиса ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Manager") // Owner | Manager (см. enums.ts)
  createdAt    DateTime @default(now())

  ownedDeals       Deal[]            @relation("DealOwner")
  assignedDeals    Deal[]            @relation("DealAssignee")
  assignedTasks    Task[]            @relation("TaskAssignee")
  uploadedVersions DocumentVersion[] @relation("VersionUploader")
}

// ── Рекламодатель / агентство (карточка CRM) ─────────────────────────────────
model Advertiser {
  id          String   @id @default(cuid())
  nameRu      String
  nameEn      String?
  legalEntity String? // юрлицо целиком, напр. АО «ТБанк»
  inn         String?
  kpp         String?
  ogrn        String?
  type        String   @default("Рекламодатель") // Рекламодатель | Агентство (см. enums.ts)
  status      String   @default("Активный")
  archived    Boolean  @default(false) // в Архиве (v2, п.1.2)
  goals       String?
  notes       String?
  // Реквизиты для карточки контрагента.
  address       String?
  bankAccount   String?
  bankName      String?
  bik           String?
  signatory     String? // подписант
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts        Contact[]
  deals           Deal[]
  documents       Document[]
  tasks           Task[]
  creatives       Creative[]
  agencyClients   AgencyClient[] // если контрагент = Агентство
  plannedPayments PlannedPayment[]
  placements      Placement[]
  dailyStatuses   DailyStatus[]
  promoBatches    PromoBatch[]
}

// ── Креатив (макет) — блок «Креативы» в карточке клиента (v2, п.1.3) ─────────
model Creative {
  id           String   @id @default(cuid())
  advertiserId String
  dealId       String?
  title        String
  size         String? // напр. 1080×1080, 1920×1080
  status       String   @default("В работе") // В работе | На согласовании | Согласован | Отклонён
  notes        String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
}

// ── Клиент агентства (если контрагент = Агентство) ──────────────────────────
model AgencyClient {
  id           String   @id @default(cuid())
  advertiserId String // агентство-владелец
  name         String
  brand        String?
  inn          String?
  notes        String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
}

// ── Контакт у рекламодателя ──────────────────────────────────────────────────
model Contact {
  id           String  @id @default(cuid())
  advertiserId String
  fio          String
  role         String?
  email        String?
  phone        String?
  telegram     String?
  isPrimary    Boolean @default(false)

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
}

// ── Сделка / проект ──────────────────────────────────────────────────────────
model Deal {
  id                   String    @id @default(cuid())
  advertiserId         String
  title                String
  dealType             String? // прямой | агентство | технический (v2, п.1.3)
  finalBrand           String? // конечный бренд (при агентстве/цепочке)
  contractConstruction String? // A..E (справочник конструкций договоров, v2 п.3.5)
  stage                String    @default("Лид") // 9 стадий (v2, п.1.1)
  urgency              String? // Максимальная | Высокая | Средняя | Низкая | По запросу | Разово
  ownerId              String?
  assigneeId           String?
  amount               Float? // сумма из МП (текущая)
  contractTotal        Float? // сумма по договору за весь период сотрудничества
  vatIncluded          Boolean   @default(true)
  currency             String    @default("RUB")
  periodText           String? // срок как ТЕКСТ, не жёсткие даты (правило блупринта)
  launchDate           DateTime? // дата запуска
  paymentTerms         String?
  contractNumber       String?
  contractDate         DateTime?
  legalResponsible     String? // юрист
  blocker              String?
  situational          String? // «Ситуативные блокеры и срочные задачи» (v2, п.1.3) — НЕ в базу знаний
  nextStep             String?
  nextStepDate         DateTime?
  decisionPending      String? // непустое → попадает в блок «Решения ждут вас»
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  advertiser  Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  owner       User?        @relation("DealOwner", fields: [ownerId], references: [id])
  assignee    User?        @relation("DealAssignee", fields: [assigneeId], references: [id])
  documents       Document[]
  tasks           Task[]
  creatives       Creative[]
  mediaPlans      MediaPlan[]
  invoices        Invoice[]
  closingDocs     ClosingDoc[]
  ordMarkings     OrdMarking[]
  promoBatches    PromoBatch[]
  plannedPayments PlannedPayment[]
  placements      Placement[]
  dailyStatuses   DailyStatus[]

  @@index([advertiserId])
  @@index([stage])
}

// ── Логический документ (напр. «Договор Т-Банк») ─────────────────────────────
model Document {
  id               String   @id @default(cuid())
  dealId           String?
  advertiserId     String
  type             String // см. DocumentType в enums.ts
  title            String
  currentVersionId String? // id актуальной DocumentVersion
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  advertiser Advertiser        @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  versions   DocumentVersion[]

  @@index([advertiserId])
  @@index([dealId])
}

// ── Конкретная версия-файл документа (иммутабельна) ──────────────────────────
model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  versionNo    Int
  storageKey   String // ключ объекта в StorageProvider
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedById String?
  changeNote   String?
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("VersionUploader", fields: [uploadedById], references: [id])

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@index([sha256])
}

// ── Задача (юрист / дизайн / менеджер / бухгалтерия / ОРД) ───────────────────
model Task {
  id           String    @id @default(cuid())
  dealId       String?
  advertiserId String?
  title        String
  kind         String    @default("Менеджер") // Юрист | Дизайн | Менеджер | Бухгалтерия | ОРД | Прочее
  assigneeId   String?
  status       String    @default("Открыта") // Открыта | В работе | Ждёт | Готова
  // На чьей стороне сейчас согласование: «Мы» | «Клиент» (доска задач).
  side         String    @default("Мы")
  dueDate      DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([dealId])
  @@index([status])
}

// ── Медиаплан сделки ─────────────────────────────────────────────────────────
model MediaPlan {
  id          String   @id @default(cuid())
  dealId      String
  version     Int      @default(1)
  totalAmount Float?
  vatRate     Int? // 20 | 22 (по дате документа)
  reachTotal  Int?
  cpv         Float?
  cpu         Float?
  notes       String?
  createdAt   DateTime @default(now())

  deal  Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lines MediaPlanLine[]

  @@index([dealId])
}

model MediaPlanLine {
  id          String  @id @default(cuid())
  mediaPlanId String
  formatCode  String?
  formatName  String
  qty         Int?
  period      String?
  unitPrice   Float?
  sum         Float?
  reach       Int?
  geo         String?

  mediaPlan MediaPlan @relation(fields: [mediaPlanId], references: [id], onDelete: Cascade)

  @@index([mediaPlanId])
}

// ── Счёт на оплату ───────────────────────────────────────────────────────────
model Invoice {
  id             String    @id @default(cuid())
  dealId         String
  number         String
  basis          String? // Приложение №… к Договору
  service        String?
  amount         Float?
  vatRate        Int?
  ourBankAccount String? // ⚠️ основной …48430 vs Самокат-fest …55743
  issuedAt       DateTime?
  appendixNo     String?
  createdAt      DateTime  @default(now())

  deal     Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([dealId])
}

// ── Факт оплаты (платёжное поручение) ───────────────────────────────────────
model Payment {
  id        String    @id @default(cuid())
  invoiceId String
  number    String?
  payer     String?
  payee     String?
  purpose   String?
  amount    Float?
  paidAt    DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ── Закрывающий документ (УПД / Отчёт / Акт сверки) ─────────────────────────
model ClosingDoc {
  id          String    @id @default(cuid())
  dealId      String
  kind        String // УПД | Отчёт | АктСверки
  number      String?
  appendixNo  String?
  upDStatus   Int? // 1 | 2
  periodStart DateTime?
  periodEnd   DateTime?
  amount      Float?
  storageKey  String?
  createdAt   DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ── Маркировка ЕРИД / ОРД ────────────────────────────────────────────────────
model OrdMarking {
  id             String    @id @default(cuid())
  dealId         String
  erid           String?
  role           String // Агентство | Клиент (и др., см. enums.ts)
  finalClient    String? // конечный заказчик при агентстве
  platform       String? // соцсети | моб.приложение | пуши
  status         String    @default("Активна")
  markedAt       DateTime?
  placementStart DateTime? // дата размещения маркировки
  placementEnd   DateTime?
  expiresAt      DateTime? // посты живут до 1 мес
  monthlyClosing Boolean   @default(true) // акты закрываются каждый месяц
  urgent         Boolean   @default(false) // срочно снять креатив / сдать акт
  // Файлы: креатив (картинка) и закрывающий акт (PDF) — метаданные в БД, файл в StorageProvider.
  creativeStorageKey String?
  creativeFileName   String?
  actStorageKey      String?
  actFileName        String?
  createdAt      DateTime  @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ── Партия промокодов ────────────────────────────────────────────────────────
model PromoBatch {
  id             String    @id @default(cuid())
  advertiserId   String? // карточки промокодов по рекламодателю
  dealId         String?
  mechanic       String // Performance | Acquisition
  nominal        Float?
  qty            Int?
  vatOnUsed      Boolean   @default(true) // +22% на использованные
  delayHours     Int       @default(12) // отсрочка выдачи ≥ 12 ч
  monetization   String    @default("Деньги") // Деньги | Бартер
  validFrom      DateTime? // срок действия
  validTo        DateTime?
  commercialTerms String? // коммерческие условия
  settlement     String? // взаиморасчёт по промокодам
  notes          String?
  createdAt      DateTime  @default(now())

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([advertiserId])
  @@index([dealId])
}

// ── Статья базы знаний ───────────────────────────────────────────────────────
model KnowledgeArticle {
  id           String   @id @default(cuid())
  category     String // см. KnowledgeCategory в enums.ts
  title        String
  bodyMarkdown String
  notes        String?
  // Порядок чтения «сверху вниз» по циклу сделки (новые статьи — в конец).
  orderIndex   Int      @default(999)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

// ── Директория ролей (кто за что отвечает) ──────────────────────────────────
model Person {
  id        String   @id @default(cuid())
  role      String
  name      String
  telegram  String?
  email     String?
  scope     String? // напр. «чек B2C», «маркировка», «клубы 50+»
  createdAt DateTime @default(now())
}

// ── Запись дневного журнала (EOD / транскрипт) ──────────────────────────────
model JournalEntry {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  source           String // EOD | Транскрипт | Чат
  rawText          String
  parsedSummary    String?
  routedTo         String? // Трекер | База | Архив
  linkedDealIds    String? // JSON-массив id (SQLite не поддерживает scalar-list)
  linkedArticleIds String? // JSON-массив id
  createdAt        DateTime @default(now())
}

// ── Плановый платёж по месяцам (финансовый календарь) ───────────────────────
model PlannedPayment {
  id           String   @id @default(cuid())
  advertiserId String
  dealId       String?
  periodMonth  String // «YYYY-MM» — месяц платежа
  amount       Float
  status       String   @default("План") // План | Оплачено | Просрочено
  paidAt       DateTime?
  note         String?
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([periodMonth])
}

// ── Бронь размещения (календарь размещений, Gantt) ──────────────────────────
// Строка = слот/формат (slot), ячейка = бренд на период (по неделям).
model Placement {
  id           String    @id @default(cuid())
  advertiserId String? // если бренд заведён как контрагент
  brandLabel   String? // свободное имя бренда (для разовых, без карточки)
  dealId       String?
  slot         String // формат/слот размещения (строка календаря)
  responsible  String? // ответственный менеджер
  startDate    DateTime
  endDate      DateTime
  status       String    @default("Ожидание") // Ожидание | На подписании | Подписан | Завершено
  notes        String?
  createdAt    DateTime  @default(now())

  advertiser Advertiser? @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  deal       Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([startDate])
}

// ── Ежедневный статус по проекту/рекламодателю (для «Сегодня» → отчёт) ──────
model DailyStatus {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  advertiserId String
  dealId       String?
  text         String
  authorId     String? // id пользователя (без жёсткой связи)
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([advertiserId])
  @@index([date])
}

// ── Аудит-лог (v2) ───────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  before     String? // JSON
  after      String? // JSON
  createdAt  DateTime @default(now())
}

// ── Фоновая задача AI-парсинга (v2) ─────────────────────────────────────────
model Job {
  id        String   @id @default(cuid())
  type      String
  payload   String? // JSON
  status    String   @default("pending") // pending | running | done | error
  result    String? // JSON
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
