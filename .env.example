# ─────────────────────────────────────────────────────────────
# Colizeum Workspace — переменные окружения
# Скопируй в .env и заполни. .env НЕ коммитим (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# База данных.
# dev: SQLite (файл рядом с проектом). prod: PostgreSQL (см. блупринт, раздел 13).
DATABASE_URL="file:./dev.db"

# Секрет для подписи cookie-сессии (любая длинная случайная строка).
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-long-random-secret-string"

# Файловое хранилище (StorageProvider).
# local — локальный диск (dev). s3 — S3-совместимое хранилище (prod, реализуется в v3).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3 (prod, пока не обязательно):
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# AI (Anthropic) — только для серверных вызовов, в v2. Ключ никогда не попадает в клиент.
# ANTHROPIC_API_KEY=""

# Пароли сотрудников для сида (необязательно). Если не заданы — берутся случайные
# дефолты из seed.ts. На проде задайте свои значения, чтобы пароли не жили в коде.
# SEED_PW_FIRSTOV=""      # Артур Фирстов   — a.firstov@colizeum.ru (админ)
# SEED_PW_IVANUSHKIN=""   # Иванушкин А.     — a.ivanushkin@colizeum.ru (руководитель)
# SEED_PW_YANYUK=""       # Марина Янюк      — m.yanyuk@colizeum.ru
# SEED_PW_TURINOVA=""     # Екатерина Т.     — e.turinova@colizeum.ru
# SEED_PW_CHEPELYUK=""    # Артём Чепелюк    — a.chepelyuk@colizeum.ru (турниры)
