# ─────────────────────────────────────────────────────────────
# Colizeum Workspace — переменные окружения
# Скопируй в .env и заполни. .env НЕ коммитим (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# База данных.
# dev: SQLite (файл рядом с проектом). prod: PostgreSQL (см. блупринт, раздел 13).
DATABASE_URL="file:./dev.db"

# Секрет для подписи cookie-сессии (любая длинная случайная строка).
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-long-random-secret-string"

# Файловое хранилище (StorageProvider).
# local — локальный диск (dev). s3 — S3-совместимое хранилище (prod, реализуется в v3).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# S3 (prod, пока не обязательно):
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── ИИ-напарник ─────────────────────────────────────────────────────────────
# Все вызовы идут с сервера, ключ в браузер не попадает.
#
# Какой провайдер использовать: qwen | kimi | anthropic | openai
# qwen и kimi — китайские, работают из России; anthropic (Claude) из РФ
# отвечает 403 «Request not allowed».
AI_PROVIDER="qwen"

# Ключ провайдера (личный кабинет Qwen/DashScope или Moonshot/Kimi).
AI_API_KEY=""

# Модель — необязательно. По умолчанию: qwen → qwen-plus, kimi → moonshot-v1-32k,
# anthropic → claude-sonnet-5. Точное название смотрите в кабинете провайдера.
# AI_MODEL="qwen-plus"

# Адрес API — необязательно, подставляется по провайдеру.
# Нужен, если у вас отдельный регион или свой шлюз.
# AI_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"

# Заявки с сайта colizeum-agency.ru («Заявки с сайта» в меню).
# Читаем рабочую Google-таблицу формы CSV-экспортом — ключи Google API не нужны,
# но у таблицы должен стоять доступ «Все, у кого есть ссылка» → «Читатель».
# По умолчанию берётся рабочая таблица; переопределите, если таблица сменится.
# LEADS_SHEET_ID="1ZKMx1VmTIvY-AyZPMuMLlgeyvLWNQvpCyywaInRbu3o"
# LEADS_SHEET_GID="0"

# Пароли сотрудников для сида (необязательно). Если не заданы — берутся случайные
# дефолты из seed.ts. На проде задайте свои значения, чтобы пароли не жили в коде.
# SEED_PW_FIRSTOV=""      # Артур Фирстов   — a.firstov@colizeum.ru (админ)
# SEED_PW_IVANUSHKIN=""   # Иванушкин А.     — a.ivanushkin@colizeum.ru (руководитель)
# SEED_PW_YANYUK=""       # Марина Янюк      — m.yanyuk@colizeum.ru
# SEED_PW_TURINOVA=""     # Екатерина Т.     — e.turinova@colizeum.ru
# SEED_PW_CHEPELYUK=""    # Артём Чепелюк    — a.chepelyuk@colizeum.ru (турниры)
