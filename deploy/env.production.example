# ─────────────────────────────────────────────────────────────────────────────
# Colizeum Agency — .env для боевого сервера.
# Скопировать в /var/www/colizeum/.env и заполнить.
# ─────────────────────────────────────────────────────────────────────────────

# База данных. Путь ОБЯЗАТЕЛЬНО абсолютный, иначе Prisma ищет файл рядом со схемой.
DATABASE_URL="file:/var/www/colizeum/data/prod.db"

# Секрет подписи cookie-сессии. Сгенерировать на сервере:  openssl rand -base64 32
AUTH_SECRET="ВСТАВЬТЕ_СЮДА_СЛУЧАЙНУЮ_СТРОКУ"

# Файловое хранилище (загруженные документы, креативы, вложения чата).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/var/www/colizeum/storage"

# ─── ИИ-напарник (можно оставить пустым — сервис работает и без него) ────────
AI_PROVIDER="deepseek"
AI_API_KEY=""
# AI_MODEL="deepseek-chat"
# AI_BASE_URL=""

# ─── Заявки с сайта (Google-таблица формы) ───────────────────────────────────
# LEADS_SHEET_ID="1ZKMx1VmTIvY-AyZPMuMLlgeyvLWNQvpCyywaInRbu3o"
# LEADS_SHEET_GID="0"

# ─── Пароли сотрудников для первого сида ─────────────────────────────────────
# Задайте свои — иначе будут случайные дефолты из seed.ts.
SEED_PW_FIRSTOV=""
SEED_PW_IVANUSHKIN=""
SEED_PW_YANYUK=""
SEED_PW_TURINOVA=""
SEED_PW_CHEPELYUK=""

# ─── Дневник → Google-таблица отчётности ─────────────────────────────────────
# Строка встречи уходит в таблицу через скрипт-приёмник внутри самой таблицы.
# Ключи Google не нужны. Пошаговая установка — docs/MEETINGS_SHEET.md.
# MEETINGS_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/…/exec"
# MEETINGS_SHEET_TOKEN=""      # тот же токен, что вписан в скрипт
# MEETINGS_SHEET_TAB=""        # имя листа; пусто — лист из скрипта

# ─── Уведомления в Telegram ──────────────────────────────────────────────────
# Вопрос руководителю, поручение и блокер приходят человеку сразу.
# Пошаговая настройка (10 минут) — docs/TELEGRAM.md.
# TELEGRAM_BOT_TOKEN=""                        # токен от @BotFather
# APP_URL="https://colizeum-agensy.space"      # для ссылок в сообщениях
