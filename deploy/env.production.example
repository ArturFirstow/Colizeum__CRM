# ─────────────────────────────────────────────────────────────────────────────
# Colizeum Agency — .env для боевого сервера.
# Скопировать в /var/www/colizeum/.env и заполнить.
# ─────────────────────────────────────────────────────────────────────────────

# База данных. Путь ОБЯЗАТЕЛЬНО абсолютный, иначе Prisma ищет файл рядом со схемой.
DATABASE_URL="file:/var/www/colizeum/data/prod.db"

# Секрет подписи cookie-сессии. Сгенерировать на сервере:  openssl rand -base64 32
AUTH_SECRET="ВСТАВЬТЕ_СЮДА_СЛУЧАЙНУЮ_СТРОКУ"

# Файловое хранилище (загруженные документы, креативы, вложения чата).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/var/www/colizeum/storage"

# ─── ИИ-напарник (можно оставить пустым — сервис работает и без него) ────────
AI_PROVIDER="deepseek"
AI_API_KEY=""
# AI_MODEL="deepseek-chat"
# AI_BASE_URL=""

# ─── Заявки с сайта (Google-таблица формы) ───────────────────────────────────
# LEADS_SHEET_ID="1ZKMx1VmTIvY-AyZPMuMLlgeyvLWNQvpCyywaInRbu3o"
# LEADS_SHEET_GID="0"

# ─── Пароли сотрудников для первого сида ─────────────────────────────────────
# Задайте свои — иначе будут случайные дефолты из seed.ts.
SEED_PW_FIRSTOV=""
SEED_PW_IVANUSHKIN=""
SEED_PW_YANYUK=""
SEED_PW_TURINOVA=""
SEED_PW_CHEPELYUK=""
