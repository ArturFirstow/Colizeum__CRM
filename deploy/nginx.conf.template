# ─────────────────────────────────────────────────────────────────────────────
# Colizeum Agency — конфиг nginx.
# Заменить DOMAIN на реальный домен и положить в /etc/nginx/sites-available/colizeum
#
# После выпуска сертификата certbot допишет сюда строку «listen 443 ssl».
# ОБЯЗАТЕЛЬНО допишите в неё http2:  listen 443 ssl http2;
# Без HTTP/2 браузер тянет десяток файлов страницы по очереди, и переходы по
# меню заметно подтормаживают.
#
# ⚠️ Пишем именно параметром в строке listen, а не отдельной директивой
# «http2 on;»: та появилась только в nginx 1.25, а в Ubuntu 24.04 идёт 1.24 —
# и с ней nginx просто не запустится. Форма с listen работает на обеих.
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN www.DOMAIN;

    # Загрузка файлов (креативы, акты, документы) — до 60 МБ.
    client_max_body_size 60m;

    # Сжатие. Next.js жмёт и сам, но статику (шрифты, svg, карты кода) он
    # отдаёт как есть — а по мобильному интернету это заметно.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/x-javascript text/xml application/xml image/svg+xml
               font/woff font/woff2;

    # Файлы сборки называются по содержимому (…-a1b2c3.js): если содержимое
    # изменилось — изменится и имя. Значит их можно смело держать в браузере
    # и не перекачивать при каждом заходе.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Живая лента мессенджера (SSE) — буферизацию выключаем, иначе сообщения
    # приходят пачками с задержкой.
    location /api/chat/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
