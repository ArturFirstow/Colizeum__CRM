{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "_comment_exclude": "⚠️ video — отдельный проект ролика со своими зависимостями, на боевой сервер они не ставятся. Без этой строки проверка типов в next build заходит в video/ и падает на '@remotion/cli/config'. Поймано на боевой выкатке.",
  "exclude": ["node_modules", "video", "scripts/*.mjs"]
}
