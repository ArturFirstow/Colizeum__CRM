# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# environment
.env
# ⚠️ Настройки тестового контура: там свой AUTH_SECRET и пароли демо-сотрудников.
# Без этой строки staging-setup.sh положил бы секреты в репозиторий.
.env.staging
.env*.local

# database (dev SQLite)
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# local file storage (dev StorageProvider)
/storage/
/storage-staging/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# misc
.DS_Store
*.pem
.vscode/
.idea/

# Служебный кэш TypeScript — пересоздаётся при каждой сборке.
tsconfig.tsbuildinfo

# версия перед последним обновлением (для ./scripts/rollback.sh)
.deploy-prev

# кеш Python (появляется, когда скрипт из scripts/ подключают как модуль)
__pycache__/
*.pyc
